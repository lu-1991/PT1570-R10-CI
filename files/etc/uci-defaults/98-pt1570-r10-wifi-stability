#!/bin/sh
# PT1570-R10：2.4G / 5G 断流缓解
#
# 断流的三个常见来源（对应三个对策，全部只动配置层，不碰驱动）：
#   1) hostapd 默认会轮询空闲终端（inactivity poll）：手机/平板进省电模式后
#      漏掉几次轮询，就被 deauth（logread 里能看到 "did not acknowledge" /
#      "inactive"）。表现为"连着连着就掉线、要手动重连"。
#      对策：skip_inactivity_poll=1（不再主动轮询空闲终端）+
#            disassoc_low_ack=0（不因低 ACK 主动踢人，由终端自己决定重连）。
#   2) 5G 默认 auto 信道可能选中 DFS 信道（52-64 / 100-144）：雷达误报会触发
#      信道切换 + CAC 重新静默等待，表现为"所有 5G 终端同时掉一下再恢复"。
#      对策：固定到 CN 合法、非 DFS 的 149 信道（149-161 可组 80MHz）。
#   3) 5G htmode 按最高协议推导会拿到 EHT80：RTL8852C 在这套自研 rtl_ax_ap
#      驱动下 EHT 能力未经充分实测（2.4G 的 HE 信标就翻过车）。HE80 是保守
#      且兼容性最好的选择（Wi-Fi 6 起的终端全部支持）。
#      对策：5G 钉 HE80。
#
# 2.4G 的信道 / htmode 由 97-pt1570-r10-wifi24 负责，本脚本不重复钉，
# 只补它没覆盖的 hostapd 行为项和 5G 项。
#
# uci-defaults 只在首启（或改配置后）跑一次；刷机"保留配置"不会重新生成
# /etc/config/wireless，此时需要手动改或恢复出厂。

log() { logger -t wifi-stability "$@"; }

# 首启顺序上本脚本可能早于 wifi config —— 没有配置就先手动生成一次
if [ ! -f /etc/config/wireless ]; then
	command -v wifi >/dev/null 2>&1 && wifi config >/dev/null 2>&1
fi
if [ ! -f /etc/config/wireless ]; then
	log "未找到 /etc/config/wireless，跳过"
	exit 0
fi

is_5g() {
	local band hwmode
	band="$(uci -q get "wireless.$1.band" 2>/dev/null)"
	if [ -n "$band" ]; then
		[ "$band" = "5g" ]
		return $?
	fi
	hwmode="$(uci -q get "wireless.$1.hwmode" 2>/dev/null)"
	[ "$hwmode" = "11a" ]
}

changed=0

# ---- 1. 所有 radio：统一国家码 CN（149 信道 / 80MHz 的合法功率表依赖它） ----
for dev in $(uci -q show wireless | sed -n 's/^wireless\.\([A-Za-z0-9_]*\)=wifi-device$/\1/p'); do
	[ "$(uci -q get "wireless.$dev.country")" = "CN" ] || {
		uci -q set "wireless.$dev.country=CN"
		log "$dev: country=CN"
		changed=1
	}
done

# ---- 2. 5G radio：固定非 DFS 信道 149 + 钉 HE80 ----
for dev in $(uci -q show wireless | sed -n 's/^wireless\.\([A-Za-z0-9_]*\)=wifi-device$/\1/p'); do
	is_5g "$dev" || continue
	uci -q set "wireless.$dev.channel=149"
	uci -q set "wireless.$dev.htmode=HE80"
	uci -q set "wireless.$dev.disabled=0"
	log "$dev: 5G 固定 channel=149 htmode=HE80（避开 DFS）"
	changed=1
done

# ---- 3. 所有 VAP：不踢空闲终端（断流主对策） ----
for vif in $(uci -q show wireless | sed -n 's/^wireless\.\([A-Za-z0-9_]*\)=wifi-iface$/\1/p'); do
	uci -q set "wireless.$vif.skip_inactivity_poll=1"
	uci -q set "wireless.$vif.disassoc_low_ack=0"
	changed=1
	log "$vif: skip_inactivity_poll=1 disassoc_low_ack=0"
done

if [ "$changed" = "1" ]; then
	uci -q commit wireless
	log "已提交 wireless 配置"
	wifi reload >/dev/null 2>&1 || true
fi

# uci-defaults 由 /etc/init.d/boot 用 "." 载入，这里必须 exit 0 而不是 return
exit 0
