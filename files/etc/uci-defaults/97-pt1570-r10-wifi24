#!/bin/sh
# PT1570-R10：2.4G 锁定 802.11n / HT20（RTL9617C + RTL8192XBE）
#
# 背景（2026-11-14 真机定位）：
#   2.4G 是 Wi-Fi 6 芯片，mac80211.uc 会按"该频段支持的最高协议"把 htmode
#   推导成 HE20。这颗芯片的 2.4G HE 信标安卓解析不了，表现为：
#     Windows：能搜到、能连接、信号满格
#     手机    ：Wi-Fi 列表里永远没有这个 SSID
#   换信道、换加密、换 SSID 全都没用；降到纯 802.11n（HT20，信标无 HE 元素）
#   后手机可正常搜到。
#
# 本脚本是第二道保险：编译期已改 mac80211.uc，但刷机若"保留配置"，
# /etc/config/wireless 不会重新生成。这里在首启阶段再钉一次。
#
# 只碰 2.4G（band=2g / hwmode=11g），5G 与 6G 完全不动。
# uci-defaults 脚本执行后由系统删除，不会每次开机都覆盖用户的修改。

log() { logger -t wifi-24g "$@"; }

# 首启顺序上本脚本可能早于 wifi config —— 没有配置就先手动生成一次
if [ ! -f /etc/config/wireless ]; then
	command -v wifi >/dev/null 2>&1 && wifi config >/dev/null 2>&1
fi
if [ ! -f /etc/config/wireless ]; then
	log "未找到 /etc/config/wireless，跳过"
	exit 0
fi

# 判定某个 radio 是否 2.4G：优先看 band；老配置没有 band 时才看 hwmode
is_24g() {
	local band hwmode
	band="$(uci -q get "wireless.$1.band" 2>/dev/null)"
	if [ -n "$band" ]; then
		[ "$band" = "2g" ]
		return $?
	fi
	hwmode="$(uci -q get "wireless.$1.hwmode" 2>/dev/null)"
	[ "$hwmode" = "11g" ]
}

changed=0

# ---- 1. 频段设备：强制 HT20 / 固定信道 6 / 国家码 CN ----
for dev in $(uci -q show wireless | sed -n 's/^wireless\.\([A-Za-z0-9_]*\)=wifi-device$/\1/p'); do
	is_24g "$dev" || continue
	uci -q set "wireless.$dev.htmode=HT20"
	uci -q set "wireless.$dev.channel=6"
	uci -q set "wireless.$dev.country=CN"
	uci -q set "wireless.$dev.legacy_rates=1"
	uci -q set "wireless.$dev.disabled=0"
	log "$dev: 2.4G 强制 htmode=HT20 channel=6 country=CN"
	changed=1
done

# ---- 2. 2.4G 的 VAP 必须启用且不隐藏（否则手机列表里同样看不到） ----
for vif in $(uci -q show wireless | sed -n 's/^wireless\.\([A-Za-z0-9_]*\)=wifi-iface$/\1/p'); do
	dev="$(uci -q get "wireless.$vif.device" 2>/dev/null)"
	[ -n "$dev" ] || continue
	is_24g "$dev" || continue
	uci -q set "wireless.$vif.disabled=0"
	uci -q set "wireless.$vif.hidden=0"
	changed=1
done

if [ "$changed" = "1" ]; then
	uci -q commit wireless
	log "已提交 wireless 配置"
	# 首启时 wifi 服务通常还没起，reload 失败不影响后续开机流程
	wifi reload >/dev/null 2>&1 || true
else
	log "未找到 2.4G radio，未做任何修改"
fi

# uci-defaults 由 /etc/init.d/boot 用 "." 载入，这里必须 exit 0 而不是 return
exit 0
