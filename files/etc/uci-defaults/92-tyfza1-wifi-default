#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Enable both radios on first boot with an SSID derived from the unit's LAN MAC
# so a freshly flashed board is usable without touching the web UI first.
# Runs once; system.@system[0].tyfza1_wifi_default marks a completed setup so a
# user who later changes SSID or key keeps that choice across reboots.
[ "$(uci -q get system.@system[0].tyfza1_wifi_default)" = "1" ] && exit 0

base=""
for f in /tmp/tyfza1-factory/lan_mac /sys/class/net/br-lan/address; do
	if [ -r "$f" ]; then
		base=$(tr -d ':' < "$f" | tr 'A-F' 'a-f')
		break
	fi
done

suffix=$(printf '%s' "$base" | tail -c 4)
[ -n "$suffix" ] || exit 0

uci -q set wireless.radio0.disabled='0'
uci -q set wireless.radio1.disabled='0'
uci -q set wireless.default_radio0.disabled='0'
uci -q set wireless.default_radio0.ssid="TYFZA1-5G-$suffix"
uci -q set wireless.default_radio0.encryption='psk2'
uci -q set wireless.default_radio0.key='12345678'
uci -q set wireless.default_radio1.disabled='0'
uci -q set wireless.default_radio1.ssid="TYFZA1-$suffix"
uci -q set wireless.default_radio1.encryption='psk2'
uci -q set wireless.default_radio1.key='12345678'
uci -q set system.@system[0].tyfza1_wifi_default='1'
uci -q commit wireless
uci -q commit system
exit 0
