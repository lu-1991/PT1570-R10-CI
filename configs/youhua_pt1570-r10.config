# ================================================================
# 基础配置（机型无关）：RTL9617C FIT ABI 共用包集合
# 由旧仓库三份配置（Config-PT1570-FIT + Config-EXTRA）合并而来。
# 用法：workflow 在 feeds 安装后 `cat 本文件 >> .config`，再执行
#       diy-part2.sh —— 它按 workflow 的 target_model 输入选中唯一机型
#       （DEVICE_*=y + 关掉其它机型）并做两次 make defconfig + 硬断言。
# ================================================================

# ---- target ----
CONFIG_TARGET_rtl9617c=y
CONFIG_TARGET_rtl9617c_generic=y
CONFIG_TARGET_BOARD="rtl9617c"
CONFIG_TARGET_SUBTARGET="generic"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a55"

# 机型不在这里写死：defconfig 会默认选中 target 的默认机型，
# diy-part2.sh 会按 TARGET_MODEL 启用所选机型并关掉其余 3 个。
# （2026-11-13 教训：多机型同编时 tianyi_* 字母序更前，取产物/校验易抓错。）

# ---- FIT ABI 必需 ----
# fitblk 提供 /lib/upgrade/fit.sh；platform.sh 用 CI_KERNPART=fit + nand_do_upgrade
CONFIG_PACKAGE_fitblk=y
# 该 target 的 host fw_printenv 会挂（上游已验证），必须关掉
# CONFIG_PACKAGE_uboot-envtools is not set

# ---- PON / 平台 ----
CONFIG_PACKAGE_tyfza1-pon-control=y
CONFIG_PACKAGE_luci-app-tyfza1-pon=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_block-mount=y

# ---- LuCI / 网络 ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_dnsmasq=y

# ---- 时区 UTC+8 ----
CONFIG_PACKAGE_zoneinfo-core=y
CONFIG_PACKAGE_zoneinfo-asia=y

# ---- 设备包（上游 DEVICE_PACKAGES 提供，显式断言防 defconfig 丢包）----
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_wpad-mbedtls=y

# ---- tailscale 三件套（2026-11-10 用户基线；vlmcsd 已确认非必需移除）----
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-tailscale-community=y
CONFIG_PACKAGE_luci-i18n-tailscale-community-zh-cn=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_LUCI_LANG_zh_Hans=y

# ---- 局域网服务四件套（2026-11-17 用户要求）----
# samba4-server 由 luci-app-samba4 依赖自动带入，这里显式写一遍防 defconfig 丢包
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_vsftpd=y
CONFIG_PACKAGE_luci-app-upnp=y
# miniupnpd 是虚拟包（PROVIDES:=miniupnpd），写它会被 defconfig 丢掉；
# 必须选真实变体：本 target 用 firewall4/nftables → nftables 变体（上游默认变体）
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-wol=y

# ---- 主题：两套并存 ----
# Vantage：diy-part2 [1d] 从上游拉库编译（锁定 v1.0.20 = 0f8d16f）
CONFIG_PACKAGE_luci-theme-vantage=y
# Argon：kenzok8 feed（feeds.conf 已钉 commit），默认主题由 pon 包的
# 97-rtl9617c-argon-default 设定；argon-config 会自带依赖 argon 主题。
# 语言包由主题生成（Makefile 里 LUCI_BASENAME:=argon-config + po/），
# 名字是 luci-i18n-argon-config-zh-cn，不是 luci-i18n-argon-theme-*。
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
